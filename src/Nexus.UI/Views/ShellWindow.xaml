<Window x:Class="Nexus.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nexus" Height="820" Width="1280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize">

    <!-- ================================================================
         RETOUCHE : rail minimal, aligne sur le concept "Less buttons.
         More intelligence." Plus de boutons Precedent/Suivant/Actualiser
         classiques (la navigation passe par les gestes clic-droit +
         glisser, deja codes cote code-behind). Couleurs derivees du
         systeme OKLCH du home (accent corail, hue 35), plus de violet
         en dur : le shell disparait au profit du contenu.
         ================================================================ -->

    <Window.Resources>
        <!-- Palette : conversion sRGB du systeme d'accent (hue 35) du home -->
        <SolidColorBrush x:Key="NxBg0" Color="#FF1F1712"/>
        <SolidColorBrush x:Key="NxBg2" Color="#FF34281F"/>
        <SolidColorBrush x:Key="NxBg3" Color="#FF443528"/>
        <SolidColorBrush x:Key="NxText" Color="#FFF7F2ED"/>
        <SolidColorBrush x:Key="NxTextDim" Color="#FFCABFB6"/>
        <SolidColorBrush x:Key="NxTextFaint" Color="#FF9B8C81"/>
        <SolidColorBrush x:Key="NxAccent" Color="#FFEE8859"/>
        <SolidColorBrush x:Key="NxAqua" Color="#FF9FD6E2"/>
        <SolidColorBrush x:Key="NxGold" Color="#FFF4AC66"/>
        <SolidColorBrush x:Key="NxHairline" Color="#22F7F2ED"/>
        <SolidColorBrush x:Key="NxGlass" Color="#14F7F2ED"/>
        <SolidColorBrush x:Key="NxOnAccent" Color="#FF241A12"/>
        <SolidColorBrush x:Key="NxVault" Color="#FF573C7E"/>
        <SolidColorBrush x:Key="NxVaultLine" Color="#FF9A6ED2"/>

        <LinearGradientBrush x:Key="NxAccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFEE8859" Offset="0"/>
            <GradientStop Color="#FFF4AC66" Offset="1"/>
        </LinearGradientBrush>

        <!-- Pill subtile : le ContentPresenter herite explicitement de la couleur
             du texte, focus retire, etats hover/pressed toujours lisibles. -->
        <Style x:Key="RailPill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NxTextDim}"/>
            <Setter Property="Background" Value="{StaticResource NxGlass}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="15" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource NxHairline}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource NxAccentGrad}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource NxOnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource NxAccentGrad}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource NxOnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vault : meme forme de pill, teinte violette (hue 300 du home) -->
        <Style x:Key="VaultPillStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource NxVault}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="vb" Background="{TemplateBinding Background}"
                                CornerRadius="15" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource NxVaultLine}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="vb" Property="Background" Value="#FF6A4992"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controle fenetre : cercle discret 30px -->
        <Style x:Key="WinCtl" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NxTextFaint}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="wb" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wb" Property="Background" Value="{StaticResource NxGlass}"/>
                                <Setter Property="Foreground" Value="{StaticResource NxText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource NxBg0}" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== RAIL MINIMAL ===== -->
            <Border Grid.Row="0" BorderBrush="{StaticResource NxHairline}" BorderThickness="0,0,0,1">
                <Grid x:Name="Rail" Background="Transparent" MouseLeftButtonDown="Rail_Drag">

                    <!-- Marque = accueil. Un clic sur le logo ramene au home. -->
                    <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                            Click="Home_Click" Cursor="Hand" ToolTip="Accueil" Background="Transparent"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="6,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="18" Height="18" Margin="0,0,10,0">
                                            <Border CornerRadius="9,9,9,0" Background="{StaticResource NxAccentGrad}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="45"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Nexus" Foreground="{StaticResource NxText}"
                                                   FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="1.2.7" Foreground="{StaticResource NxTextFaint}"
                                                   FontSize="11" Margin="7,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Actions : pas de retour/avance/actualiser, la nav passe par les gestes -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">

                        <!-- Vault : contenu en Content direct pour que VaultText reste accessible en code-behind -->
                        <Button x:Name="VaultPill" Click="Vault_Click" Margin="4,0"
                                Style="{StaticResource VaultPillStyle}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#128737;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VaultText" Text="Vault - 0 bloques" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Resumer : IA contextuelle, visible seulement sur une vraie page -->
                        <Button x:Name="SummarizeBtn" Content="&#10024;  Resumer" Click="Summarize_Click"
                                Style="{StaticResource RailPill}" Margin="4,0" Visibility="Collapsed"/>
                        <Button x:Name="FavBtn" Content="&#9734;  Favoris" Click="Fav_Click"
                                Style="{StaticResource RailPill}" Margin="4,0"/>
                        <Button Content="Spaces" Click="Spaces_Click"
                                Style="{StaticResource RailPill}" Margin="4,0"/>

                        <Border Width="1" Height="18" Background="{StaticResource NxHairline}" Margin="10,0"/>

                        <Button Content="&#8211;" Click="Min_Click" Style="{StaticResource WinCtl}" Margin="2,0" ToolTip="Reduire"/>
                        <Button Content="&#9723;" Click="Max_Click" Style="{StaticResource WinCtl}" Margin="2,0" ToolTip="Agrandir"/>
                        <Button x:Name="CloseBtn" Content="&#10005;" Click="Close_Click" Margin="2,0" Cursor="Hand"
                                Width="30" Height="30" Foreground="{StaticResource NxTextFaint}" Background="Transparent"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cb" Property="Background" Value="#FFC0392B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CONTENU WEB ===== -->
            <wv2:WebView2 x:Name="Web" Grid.Row="1"/>

            <!-- Overlay de chargement, aux couleurs du home -->
            <Border x:Name="LoadingOverlay" Grid.Row="1" Background="{StaticResource NxBg0}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border CornerRadius="20,20,20,0" Background="{StaticResource NxAccentGrad}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Text="Nexus" Foreground="{StaticResource NxText}" FontSize="24"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingUrl" Text="" Foreground="{StaticResource NxTextFaint}"
                               FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,18,0,0"
                                 Foreground="{StaticResource NxAccent}" Background="{StaticResource NxBg2}"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Orb de commande IA -->
            <Border x:Name="OrbVeil" Grid.RowSpan="2" Background="#CC17110D"
                    Visibility="{Binding Orb.IsOpen, Converter={StaticResource BoolToVis}}">
                <Border VerticalAlignment="Top" Margin="0,140,0,0" Width="620"
                        Background="#F22A2018" CornerRadius="22" Padding="20"
                        BorderBrush="{StaticResource NxHairline}" BorderThickness="1">
                    <StackPanel>
                        <TextBox x:Name="OrbInput" FontSize="18" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource NxText}"
                                 CaretBrush="{StaticResource NxAccent}"
                                 Text="{Binding Orb.Input, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding Orb.ModeLabel}" Foreground="{StaticResource NxAccent}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Orb.InlineResult}" Foreground="{StaticResource NxText}"
                                   FontSize="22" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
