<Application x:Class="Nexus.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:Nexus.UI.Mvvm">
    <Application.Resources>
    <mvvm:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <Color x:Key="Bg0">#1F1712</Color>
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="CoralBrush" Color="#EE8859"/>
</Application.Resources>
</Application>